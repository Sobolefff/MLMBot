# Telegram
BOT_TOKEN=

# По умолчанию бот ходит в облачный api.telegram.org, который отдаёт боту
# файлы не больше 20 МБ (getFile) — этого мало для PDF-каталогов с фото.
# Чтобы снять ограничение, поднимите self-hosted Bot API сервер (см. раздел
# README "Self-hosted Bot API сервер" — сервис telegram-bot-api в
# docker/docker-compose.yml) и укажите его адрес здесь, например:
#   TELEGRAM_API_ROOT=http://telegram-bot-api:8081   (при запуске через docker compose)
#   TELEGRAM_API_ROOT=http://localhost:8081          (bare-metal)
TELEGRAM_API_ROOT=https://api.telegram.org
# Нужны ТОЛЬКО для self-hosted telegram-bot-api сервера (сервис telegram-bot-api
# в docker-compose) — получить свои на https://my.telegram.org/apps (раздел
# "API development tools"). Это отдельные от BOT_TOKEN учётные данные приложения.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Собственный потолок на размер PDF-каталога, который бот согласен принять и
# разобрать за раз (свыше — независимо от лимитов самого Telegram)
MAX_PDF_UPLOAD_MB=150

# Server
PORT=3000
NODE_ENV=development

# Database
SQLITE_PATH=./data/greenway.db

# Redis
REDIS_URL=redis://localhost:6379

# Auth
# In production this MUST be overridden with a long, random, unique value
# (32+ chars) — the app refuses to start in NODE_ENV=production if this is
# left unset or equal to the placeholder below.
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# CORS: comma-separated list of browser origins allowed to call this API
# (e.g. an admin panel). Leave empty to deny all cross-origin browser
# requests — the Telegram bot and server-to-server callers are unaffected.
ALLOWED_ORIGINS=

# Greenway parser
GREENWAY_CATALOG_URL=
PARSER_CRON=0 3 * * *

# Notifications
DEFAULT_TIMEZONE=Europe/Moscow

# Личный кабинет Greenway (pyapi.greenwaystart.com) — бизнес-аналитика партнёра
# и каталог товаров. См. src/greenway/*.
#
# ⚠️ 24.09.2026: несколько ручных попыток синка подряд привели к временной
# блокировке IP реального аккаунта партнёра анти-бот системой Greenway.
# ИНТЕГРАЦИЯ ПРИОСТАНОВЛЕНА по решению пользователя — не запускать
# npm run gw:connect / gw:sync-catalog и не включать cron без явного разрешения.
# См. TODO.md и память reference-greenway-pyapi.
GW_API_BASE_URL=https://pyapi.greenwaystart.com/pyapi/v1/
# Обязателен для src/greenway/tokenCrypto.js — генерировать через: openssl rand -hex 32
GREENWAY_TOKEN_ENC_KEY=
# Минимальный интервал между запросами к pyapi (мс) — намеренно консервативный
# после инцидента с блокировкой выше
GW_REQUEST_MIN_INTERVAL_MS=3000
