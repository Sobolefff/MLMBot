# Telegram
BOT_TOKEN=

# Server
PORT=3000
NODE_ENV=development

# Database
SQLITE_PATH=./data/greenway.db

# Redis
REDIS_URL=redis://localhost:6379

# Auth
# In production this MUST be overridden with a long, random, unique value
# (32+ chars) — the app refuses to start in NODE_ENV=production if this is
# left unset or equal to the placeholder below.
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# CORS: comma-separated list of browser origins allowed to call this API
# (e.g. an admin panel). Leave empty to deny all cross-origin browser
# requests — the Telegram bot and server-to-server callers are unaffected.
ALLOWED_ORIGINS=

# Greenway parser
GREENWAY_CATALOG_URL=
PARSER_CRON=0 3 * * *

# Notifications
DEFAULT_TIMEZONE=Europe/Moscow

# Личный кабинет Greenway (pyapi.greenwaystart.com) — бизнес-аналитика партнёра
# (команда/финансы/PRO-бонус), НЕ каталог товаров. См. src/greenway/*.
GW_API_BASE_URL=https://pyapi.greenwaystart.com/pyapi/v1/
# Обязателен для src/greenway/tokenCrypto.js — генерировать через: openssl rand -hex 32
GREENWAY_TOKEN_ENC_KEY=
# Минимальный интервал между запросами к pyapi (мс) — не долбить API чаще необходимого
GW_REQUEST_MIN_INTERVAL_MS=1000
